{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumo",
  "version": "1.0.4",
  "identifier": "com.lumo.assistant",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lumo",
        "width": 310,
        "height": 150,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJEQTYzNUQ4MTJENDU5NzIKUldSeVdkUVMyRFdtdlRkTXdGYUpqakVQT05wVmFtVkNzVlk0RmZyeTRSVlJjM3FFSWh4ZVZYSXYK",
      "endpoints": [
        "https://github.com/VitorSilva010/Lumo/releases/latest/download/latest.json"
      ]
    }
  }
}